@TripJournalAPI_HostAddress = http://localhost:5028

GET {{TripJournalAPI_HostAddress}}/api/TripJournal
Accept: application/json

###
POST http://localhost:5028/api/TripJournal
Content-Type: application/json

{
  "date": "2026-07-10T00:00:00",
  "weather": "Sunny",
  "temperature": 28,
  "activities": "Klonen erfolgreich abgeschlossen, Datenbank läuft!",
  "notes": "Erster echter DB Eintrag auf dem neuen Rechner.",
  "mood": "Relieved"
}

###
PUT http://localhost:5028/api/TripJournal/2
Content-Type: application/json

    {
    "id": 2,
    "date": "2026-07-08T13:18:48.0355974+02:00",
    "weather": "Sunny",
    "temperature": 23,
    "activities": "Visited Picasso Museum",
    "notes": "Queues were long, but worth it.",
    "mood": "hot"
  }

###
DELETE http://localhost:5028/api/TripJournal/1
